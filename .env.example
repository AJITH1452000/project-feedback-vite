# Copy to .env (optional — every value has a sensible default).

# ---- Frontend (exposed to the browser — never put secrets here) ----
# Where the browser sends API calls. Vite proxies /api and /socket.io to API_PROXY_TARGET.
VITE_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:4000

# ---- API server (server/index.js) ----
API_PORT=4000
API_HOST=127.0.0.1
# Where the JSON database is stored (default: server/data/db.json)
# DATA_DIR=

# Optional: OpenAI rating suggestions. Without a key the built-in analyser is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: OpenAI rating suggestions. Without a key the built-in analyser is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
