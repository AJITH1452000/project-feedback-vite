# ---- Frontend (exposed to the browser — never put secrets here) ----
# Empty  → demo mode (sample data in the browser, no backend needed).
# /api   → live MySQL backend (profeed-backend). Vite proxies /api and /socket.io to API_PROXY_TARGET.
VITE_API_URL=/api

# Where the dev/preview proxy forwards /api and /socket.io (the profeed-backend server).
API_PROXY_TARGET=http://127.0.0.1:4000

# ---- Server-side only (AI rating suggestions). Never prefix with VITE_. ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_SERVER_PORT=3001
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
